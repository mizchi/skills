export function quoteInvoice(net: number, tax: number) { return Math.round(net * (1 + tax)) }
export function expireSessions<A extends {lastSeen: number}>(sessions: A[], now: number) {
  return sessions.filter(s => now - s.lastSeen < 86_400_000)
}
