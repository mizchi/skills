{
  "name": "line-count-maintenance",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "secrets": "secretlint \"**/*\"",
    "hooks": "git config --local core.hooksPath .githooks",
    "changelog": "git-cliff --tag \"v$npm_package_version\" -o CHANGELOG.md"
  },
  "devDependencies": {
    "git-cliff": "2.14.2",
    "lint-staged": "^16.0.0",
    "secretlint": "14.0.1"
  },
  "lint-staged": {
    "*": "secretlint"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.22.0"
}
