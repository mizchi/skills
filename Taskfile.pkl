amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.9.0#/Taskfile.pkl"

local skillFrontmatterSources: Listing<String> = new {
  "**/SKILL.md"
  "scripts/validate-skill-frontmatter.rb"
}

local checkFrontmatter: Task = new {
  name = "check:frontmatter"
  description = "Validate YAML frontmatter in tracked SKILL.md files"
  cmd = "ruby scripts/validate-skill-frontmatter.rb"
  inputs = skillFrontmatterSources
}

local testFrontmatter: Task = new {
  name = "test:frontmatter"
  description = "Run tests for the SKILL.md frontmatter validator"
  cmd = "ruby scripts/validate-skill-frontmatter_test.rb"
  inputs {
    "scripts/validate-skill-frontmatter.rb"
    "scripts/validate-skill-frontmatter_test.rb"
  }
}

local genReadme: Task = new {
  name = "gen:readme"
  description = "Generate / sync a boilerplate README.md next to each SKILL.md"
  cmd = "ruby scripts/gen-skill-readme.rb"
  cache = false
}

local checkReadme: Task = new {
  name = "check:readme"
  description = "Verify each skill README is in sync with its SKILL.md (CI)"
  cmd = "ruby scripts/gen-skill-readme.rb --check"
  inputs {
    "**/SKILL.md"
    "**/README.md"
    "scripts/gen-skill-readme.rb"
  }
}

local testMaintainerPersona: Task = new {
  name = "test:maintainer-persona"
  description = "Run node tests for maintainer-persona scripts"
  cmd = "node --test 'maintainer-persona/scripts/*_test.ts'"
  inputs {
    "maintainer-persona/scripts/*.ts"
  }
}

local testOssMaintainer: Task = new {
  name = "test:oss-maintainer"
  description = "Run node tests for the oss-maintainer release policy check"
  cmd = "node --test oss-maintainer/scripts/release-policy_test.mjs"
  inputs {
    "oss-maintainer/scripts/*.mjs"
    "oss-maintainer/assets/**"
  }
}

local testMizchiSkill: Task = new {
  name = "test:mizchi-skill"
  description = "Test the mizchi-skill router scripts and check that its catalog is up to date"
  cmd = "python3 mizchi-skill/scripts/test_catalog.py && python3 mizchi-skill/scripts/gen_catalog.py --check"
  cache = false
}

local testBazelBuildCache: Task = new {
  name = "test:bazel-build-cache"
  description = "Test the Bazel hygiene check and run it on the bundled example"
  cmd = "python3 bazel-build-cache/scripts/test_check_bazel_hygiene.py && python3 bazel-build-cache/scripts/check_bazel_hygiene.py bazel-build-cache/assets/polyglot"
  inputs {
    "bazel-build-cache/scripts/*.py"
    "bazel-build-cache/assets/polyglot/**"
  }
}

local testHyperfineBenchmark: Task = new {
  name = "test:hyperfine-benchmark"
  description = "Test the hyperfine export comparison script"
  cmd = "python3 hyperfine-benchmark/scripts/test_compare_runs.py"
  inputs {
    "hyperfine-benchmark/scripts/*.py"
  }
}

local testFormalMethodsReconciler: Task = new {
  name = "test:formal-methods-reconciler"
  description = "Test the proof-escape checker"
  cmd = "python3 formal-methods-reconciler/scripts/test_check_proof_escapes.py"
  inputs {
    "formal-methods-reconciler/scripts/*.py"
  }
}

local testWaxa: Task = new {
  name = "test:waxa"
  description = "Type-check and test the waxa CLI (end-to-end against a fake claude)"
  cmd = "pnpm --dir tools/waxa install --frozen-lockfile --silent && pnpm --dir tools/waxa run check && pnpm --dir tools/waxa test"
  inputs {
    "tools/waxa/src/**"
    "tools/waxa/test/**"
    "tools/waxa/package.json"
    "tools/waxa/pnpm-lock.yaml"
  }
}

local test: Task = new {
  name = "test"
  description = "Run repository checks"
  deps {
    testFrontmatter
    testMaintainerPersona
    testOssMaintainer
    testMizchiSkill
    testBazelBuildCache
    testHyperfineBenchmark
    testFormalMethodsReconciler
    testWaxa
    checkFrontmatter
    checkReadme
  }
}

local preCommit: Task = new {
  name = "pre-commit"
  description = "Pre-commit gate for skill metadata"
  cmd = "echo pre-commit ok"
  cache = false
  deps {
    checkFrontmatter
    checkReadme
  }
}

tasks {
  checkFrontmatter
  testFrontmatter
  testMaintainerPersona
  testOssMaintainer
  testMizchiSkill
  testBazelBuildCache
  testHyperfineBenchmark
  testFormalMethodsReconciler
  testWaxa
  genReadme
  checkReadme
  test
  preCommit
}
