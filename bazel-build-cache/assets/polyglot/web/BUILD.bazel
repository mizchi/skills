load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

ts_project(
    name = "render_ts",
    srcs = ["render.ts"],
    declaration = True,
    transpiler = "tsc",
    tsconfig = "//:tsconfig",
    deps = ["//:node_modules/@types/node"],
)

js_binary(
    name = "render",
    data = [":render_ts"],
    entry_point = "render.js",
)

js_run_binary(
    name = "report",
    srcs = ["//report:summary"],
    outs = ["report.txt"],
    args = [
        "../../../$(execpath //report:summary)",
        "../../../$(execpath report.txt)",
    ],
    tool = ":render",
    visibility = ["//visibility:public"],
)
