# APM dependencies
apm_modules/
.apm/
.agents/skills/
.claude/skills/

# Reproducible evaluation baselines are tracked; ad-hoc lint output is not.
.jev-lint/latest.json
.jev-lint/translations-latest.json
.jev-lint/baseline.json
.jev-lint/rules/**/last.json

# MoonBit build artifacts (inside asset project dirs)
_build/
target/
.mooncakes/

# Node / JS
node_modules/

# Pinned local documentation tools and transient link-check results
.tools/lychee/
.lycheecache
.cache/markdown-links/
.cache/skill-freshness/

# Editor / OS
.DS_Store
.vscode/
.claude/settings.local.json

# Personal skills not tracked by this public repo
chloe-chat/

# waxa runtime artifacts
results/
.waza-cache/
# ledger.yaml は per-skill cumulative knowledge — General Fix Rule の
# 累積、再発検知のための履歴。track する。
# (個別 skill で「track したくない」場合のみ skill-local .gitignore で除外)

# Subagent / discovery scratch dirs (cloned repos, fetched READMEs)
.tmp-*/
_tmp_*/

# Python bytecode
__pycache__/
*.pyc

# first-reader run state (regenerable; see ai-index/examples for a kept run)
.first-reader/
